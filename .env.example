PORT=5002
API_PORT=5001
# Optional persistent SQLite file path for hosted deployments, e.g. /data/app-data.sqlite
DATABASE_PATH=
# The frontend origin must match an Authorized JavaScript origin in Google Cloud Console.
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Exact HTTPS Google OAuth callback URL, e.g. https://your-service.up.railway.app/api/auth/google/mobile/callback
GOOGLE_MOBILE_REDIRECT_URI=https://your-service.up.railway.app/api/auth/google/mobile/callback
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_embed_api_key
# Optional: enables Gemini answers grounded with Google Search. Without a key, the chat uses public search sources.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Set this when the frontend and API are deployed on different origins.
REACT_APP_API_URL=http://localhost:5001
# Admin password is required for the admin email; set a unique value only in Railway.
ADMIN_PASSWORD=
# Resend email API (preferred). The sender address must be verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Nilgiris Tourism <noreply@your-verified-domain.com>
# Optional Gmail SMTP fallback if Resend is not configured.
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_app_password
# Required in production. Generate a long random value and store it only in Railway.
JWT_SECRET=replace_with_a_long_random_secret
# Razorpay keys for UPI. The key ID is public; the secret and webhook secret stay on the server.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
